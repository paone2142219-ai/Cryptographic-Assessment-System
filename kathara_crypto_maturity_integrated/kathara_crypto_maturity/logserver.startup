#!/usr/bin/env bash
# logserver.startup — syslog server cifrato (rsyslog + TLS, RFC 5425)
set -e

ip addr add 10.2.0.12/24 dev eth0
ip link set eth0 up; ip link set lo up
ip route add default via 10.2.0.1 dev eth0

mkdir -p /var/log/remote
nohup rsyslogd -n > /var/log/rsyslogd.log 2>&1 &

mkdir -p /shared/logserver
echo "[logserver] avvio completato — syslog TLS su 10.2.0.12:6514"
