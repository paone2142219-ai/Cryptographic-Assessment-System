#!/usr/bin/env bash
# apigw.startup — API Gateway TLS 1.3, dual-homed DMZ + service mesh
set -e

ip addr add 10.1.0.10/24 dev eth0   # netdmz
ip addr add 10.4.0.1/24  dev eth1   # netmesh (apigw fa anche da gateway del mesh)
ip link set eth0 up; ip link set eth1 up; ip link set lo up

ip route add default via 10.1.0.1 dev eth0

rm -f /etc/nginx/sites-enabled/default

# Bridge HTTP->gRPC/mTLS verso il service mesh (svca/svcb). Usa lo stesso
# cert/key di apigw già presenti in /etc/pki (extendedKeyUsage include
# clientAuth, vedi gen_pki.sh): nessuna PKI aggiuntiva da distribuire,
# apigw diventa anche client mTLS del mesh con la propria identità.
nohup python3 /opt/gw/grpc_proxy.py > /var/log/grpc_proxy.log 2>&1 &

service nginx start

mkdir -p /shared/apigw
echo "[apigw] avvio completato — HTTPS TLS 1.3 su 10.1.0.10:443, bridge mesh su /api/mesh/*"
