#!/usr/bin/env bash
# clientext.startup — client road-warrior esterno
set -e

ip addr add 10.0.0.50/24 dev eth0
ip link set eth0 up; ip link set lo up
ip route add default via 10.0.0.1 dev eth0


chmod 600 /root/.ssh/bob_admin_ed25519

/usr/sbin/charon-systemd &
sleep 3
chmod 600 /etc/swanctl/conf.d/secrets.conf
swanctl --load-all
chmod 600 /root/.ssh/id_ed25519 


cat >> /root/.ssh/config << 'EOF'
Host bastion-jump
    HostName 10.3.0.2
    User admin
    IdentityFile /root/.ssh/bob_admin_ed25519

Host appserver-jump
    HostName 10.2.0.10
    User admin
    ProxyJump bastion-jump
    IdentityFile /root/.ssh/bob_admin_ed25519
EOF



echo "[clientext] pronto. Per stabilire il tunnel road-warrior:"
echo "    swanctl --initiate --child rw-employee-child   # identità employee"
echo "    swanctl --initiate --child rw-admin-child       # identità admin"
echo "[clientext] avvio completato"
