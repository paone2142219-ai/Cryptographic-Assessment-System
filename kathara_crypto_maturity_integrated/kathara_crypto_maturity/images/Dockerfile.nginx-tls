# images/Dockerfile.nginx-tls — apigw
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx iproute2 iputils-ping \
        python3 python3-pip \
    && pip3 install --break-system-packages --no-cache-dir grpcio protobuf \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default
# python3 + grpcio: eseguono /opt/gw/grpc_proxy.py, il bridge locale
# HTTP -> gRPC/mTLS che nginx invoca in location /api/mesh/ per far
# entrare apigw come client autenticato del service mesh (svca, svcb).
CMD ["/bin/bash"]
