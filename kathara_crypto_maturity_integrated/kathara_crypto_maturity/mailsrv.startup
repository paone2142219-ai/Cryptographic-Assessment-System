#!/usr/bin/env bash
# mailsrv.startup — mail server DMZ (Postfix, STARTTLS obbligatorio)
set -e

ip addr add 10.1.0.11/24 dev eth0
ip link set eth0 up; ip link set lo up
ip route add default via 10.1.0.1 dev eth0

newaliases 2>/dev/null || true
service postfix start

echo "[mailsrv] avvio completato — SMTP con STARTTLS obbligatorio su 10.1.0.11:25"
